{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main"],
  "extends": ["config:recommended"],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust patch/minor updates"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "GitHub Actions updates"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["needs-human"]
    },
    {
      "description": "In 0.x crates a minor bump is a breaking change (Cargo semver): review it like a major.",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "groupName": "Rust 0.x minor updates (breaking)",
      "automerge": false,
      "labels": ["needs-human"]
    },
    {
      "description": "The GPUI crates are exact-pinned pre-releases that move together: one reviewed PR.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["gpui-pre", "gpui-pre-platform", "gpui-component", "gpui-kit-assets"],
      "groupName": "GPUI stack",
      "automerge": false,
      "labels": ["needs-human"]
    },
    {
      "description": "wasmtime crates pin each other exactly (wasmtime-environ, wiggle): patch and minor bumps must move together.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["wasmtime", "wasmtime-*", "wiggle", "wiggle-*"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "wasmtime"
    }
  ]
}
